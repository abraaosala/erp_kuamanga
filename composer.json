{
    "name": "salaab/erp",
    "description": "O projecto da Geralda Bartolomeu para o final do curso",
    "type": "project",
    "require": {
        "php": "^8.3",
        "dompdf/dompdf": "^3.1",
        "eftec/bladeone": "^4.10",
        "filp/whoops": "^2.15",
        "illuminate/config": "^12.69",
        "illuminate/container": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/events": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/pagination": "^12.0",
        "illuminate/routing": "^12.0",
        "illuminate/validation": "^12.0",
        "robmorgan/phinx": "^0.16",
        "symfony/clock": "^7.0",
        "symfony/config": "^7.0",
        "symfony/console": "^7.0",
        "symfony/error-handler": "^7.0",
        "symfony/event-dispatcher": "^7.0",
        "symfony/filesystem": "^7.0",
        "symfony/string": "^7.0",
        "symfony/translation": "^7.0",
        "symfony/var-dumper": "^7.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php console test",
        "lint": "vendor/bin/phpstan",
        "cs": "vendor/bin/php-cs-fixer fix",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run --diff"
    },
    "authors": [
        {
            "name": "Abraao Sala",
            "email": "abraaosala@hotmail.com"
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "kylekatarnls/update-helper": true,
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "pestphp/pest": "^5.0",
        "phpstan/phpstan": "^2.2"
    }
}
